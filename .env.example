# ======================
# 数据库
# ======================
MYSQL_USER=root
MYSQL_PASSWORD=你的MySQL密码

# ======================
# Redis
# ======================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ======================
# JWT
# ======================
JWT_SECRET=你的JWT密钥

# ======================
# DeepSeek API
# 文本对话 + 报告图片识别（deepseek-flash 多模态）都用这一个 Key
# ======================
DEEPSEEK_API_KEY=你的DeepSeek_API_Key

# ======================
# 高德地图
# ======================
GAODE_AK=你的高德地图AK

# ======================
# 微信小程序
# ======================
WECHAT_APPID=你的小程序AppID
WECHAT_SECRET=你的小程序Secret
