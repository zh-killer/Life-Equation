# ============================================================
# 生命方程式 (Life Equation) - 环境变量配置模板
# ============================================================
# 使用方式：
#   1. 复制此文件为 .env
#   2. 修改 .env 中的值为你的实际配置
#   3. Docker Compose 会自动读取 .env 文件
#   4. 本地开发时，IDEA 运行配置中设置这些环境变量
# ============================================================

# --- 数据库 ---
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_SECRET=your-jwt-secret-key-change-in-production

# --- DeepSeek AI (https://platform.deepseek.com) ---
# 文本对话 + 报告图片识别（deepseek-flash 多模态）都用这一个 Key
DEEPSEEK_API_KEY=your_deepseek_api_key
